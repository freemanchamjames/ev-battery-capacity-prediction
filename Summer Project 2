id":"So8q1FeiXo_L"},"id":"So8q1FeiXo_L"},{"cell_type":"code","source":["# Build the crosstab (rows = brand, columns = car body type, values = counts)\n","ctab = pd.crosstab(ev_data['brand'], ev_data['car_body_type'])\n","\n","# Plot the crosstab as a stacked bar chart\n","ax = ctab.plot(kind='bar', stacked=True, figsize=(12, 6), edgecolor='none')\n","\n","ax.set_title('Brand Dominance by Segment')\n","ax.set_xlabel('Brand')\n","ax.set_ylabel('Stacked Count')\n","\n","ax.legend(title='Body Type', bbox_to_anchor=(1.02, 1), loc='upper left')\n","\n","# Add labels INSIDE each stacked segment\n","for i, (idx, row) in enumerate(ctab.iterrows()):\n","    cumul = 0  # running total for this bar (used to know where the current segment starts)\n","    # Loop through each body type (i.e. each column) in the same order used in the plot\n","    for col in ctab.columns:\n","        val = row[col]  # count for this brand + this body type\n","        if val > 0:\n","            # Place text at: x = bar index (i),\n","            # y = middle of the current segment (cumul + val/2)\n","            ax.text(\n","                i,\n","                cumul + val / 2,\n","                f'{int(val)}',          # label text (make sure it's an int)\n","                ha='center',\n","                va='center',\n","                fontsize=8\n","            )\n","        # move the \"floor\" up by this segment's height so the next label sits on top\n","        cumul += val  # even if val == 0 we need to move on\n","\n","for i, total in enumerate(ctab.sum(axis=1)):\n","    ax.text(\n","        i,\n","        total,               # y = very top of the bar\n","        f'{int(total)}',     # show total as int\n","        ha='center',\n","        va='bottom',         # sit just above the bar\n","        fontsize=8,\n","        clip_on=False        # allow text to go a bit outside the axes\n","    )\n","\n","plt.xticks(rotation=80)\n","\n","plt.tight_layout()\n","\n","plt.show()\n"],"metadat