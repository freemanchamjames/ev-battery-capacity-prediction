cb5ca76aaf2","collapsed":true},"id":"lEBsIiVTYEAX","execution_count":399,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x2000 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["###Univariate-by-group visualization"],"metadata":{"id":"E_marnYrlIuw"},"id":"E_marnYrlIuw"},{"cell_type":"markdown","source":["There are two plots here.  The first is using Outlier Removed data the second is using all data. Both plots are only showing brands with IQR > 40.  This is done to remove bands that have minimal or no IQR."],"metadata":{"id":"R6nuRayCNFH-"},"id":"R6nuRayCNFH-"},{"cell_type":"code","source":["# Create dataframe for IQR filtering\n","iqr_tbl = (\n","    ev_data_cleaned\n","    .dropna(subset=['brand', 'range_km'])\n","    .groupby('brand', dropna=False)['range_km']\n","    .agg(q1=lambda s: s.quantile(0.25),\n","         q3=lambda s: s.quantile(0.75))\n",")\n","\n","iqr_tbl['IQR'] = iqr_tbl['q3'] - iqr_tbl['q1']\n","\n","keep_brands = iqr_tbl.query('IQR > 40').index\n","\n","# Brands with IQR <= 40 go into the \"discarded\" group\n","discarded_brands = iqr_tbl.query('IQR <= 40').index\n","\n","# Orders by median within each subset for readable y-axis\n","order_keep = (\n","    ev_data_cleaned[ev_data_cleaned['brand'].isin(keep_brands)]\n","    .groupby('brand')['range_km'].median()\n","    .sort_values()\n","    .index\n",")\n","\n","# For discarded brands\n","order_disc = (\n","    ev_data_cleaned[ev_data_cleaned['brand'].isin(discarded_brands)]\n","    .groupby('brand')['range_km'].median()\n","    .sort_values()\n","    .index\n",")\n","\n","# Override order_disc to be alphabetical (case-insensitive)\n","order_disc = sorted(discarded_brands, key=str.lower)\n","\n","n_rows = max(len(keep_brands), len(discarded_brands))\n","\n","fig_h = max(6, 0.35 * max(1, n_rows))\n","\n","# Create side-by-side subplots: one for kept brands, one for discarded brands\n","fig, axes = plt.subplots(\n","    ncols=2, sharex=True, figsize=(16, fig_h),\n","    gridspec_kw=dict(wspace=0.12)\n",")\n","\n","\n","# Left subplot: kept brands\n","ax = axes[0]\n","if len(keep_brands) > 0:\n","    sns.boxplot(\n","        data=ev_data_cleaned[ev_data_cleaned['brand'].isin(keep_brands)],\n","        x='range_km',\n","        y='brand',\n","        order=order_keep,\n","        ax=ax\n","    )\n","    ax.set_title(\n","        f'Cleaned - Dataset\\nRange by Brand — Kept (IQR > 40)\\nBrands: {len(keep_brands)}'\n","    )\n","else:\n","    # If no brands meet the IQR > 40 criterion, show a message instead of an empty plot\n","    ax.axis('off')\n","    ax.text(\n","        0.5, 0.5,\n","        'No brands kept (IQR > 40)',\n","        ha='center', va='center', fontsize=12\n","    )\n","\n","ax.set_ylabel('Brand')\n","ax.grid(axis='x', alpha=0.2)\n","\n","# Right subplot: discarded brands\n","ax = axes[1]\n","if len(discarded_brands) > 0:\n","    sns.boxplot(\n","        data=ev_data_cleaned[ev_data_cleaned['brand'].isin(discarded_brands)],\n","        x='range_km',\n","        y='brand',\n","        order=order_disc,\n","        ax=ax\n","    )\n","    ax.set_title(\n","        f'Cleaned - Dataset\\nRange by Brand — Discarded (IQR ≤ 40)\\nBrands: {len(discarded_brands)}'\n","    )\n","else:\n","    # If there are no discarded brands, show a message instead\n","    ax.axis('off')\n","    ax.text(\n","        0.5, 0.5,\n","        'No brands discarded (IQR ≤ 40)',\n","        ha='center', va='center', fontsize=12\n","    )\n","\n","axes[1].set_ylabel('')\n","\n","for a in axes:\n","    a.set_xlabel('Range (km)')\n","\n","plt.tight_layout()\n","\n","plt.show()\n"],"metadata":{"id":"tl-JXUM0Mp4r","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1779466907566,"user_tz":300,"elapsed":1667,"user":{"displayName":"James Freeman","userId":"16779712946894364401"}},"outputId":"8b13d71b-6633-45c5-f9aa-9bf4b3bf88e1","collapsed":true},"id":"tl-JXUM0Mp4r","